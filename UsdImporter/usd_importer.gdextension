[configuration]

entry_symbol = "ExtensionInit"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

macos.debug                 = "res://addons/UsdImporter/bin/usd_importer.macos.template_debug.framework"
macos.debug.dev             = "res://addons/UsdImporter/bin/usd_importer.macos.template_debug.dev.framework"
macos.release               = "res://addons/UsdImporter/bin/usd_importer.macos.template_release.framework"

ios.debug                   = "res://addons/UsdImporter/bin/usd_importer.ios.template_debug.xcframework"
ios.debug.dev               = "res://addons/UsdImporter/bin/usd_importer.ios.template_debug.dev.xcframework"
ios.release                 = "res://addons/UsdImporter/bin/usd_importer.ios.template_release.xcframework"

windows.debug.x86_32        = "res://addons/UsdImporter/bin/debug/usd_importer.windows.template_debug.x86_32.dll"
windows.debug.dev.x86_32    = "res://addons/UsdImporter/bin/debug/usd_importer.windows.template_debug.dev.x86_32.dll"
windows.release.x86_32      = "res://addons/UsdImporter/bin/release/usd_importer.windows.template_release.x86_32.dll"
windows.debug.x86_64        = "res://addons/UsdImporter/bin/debug/usd_importer.windows.template_debug.x86_64.dll"
windows.debug.dev.x86_64    = "res://addons/UsdImporter/bin/debug/usd_importer.windows.template_debug.dev.x86_64.dll"
windows.release.x86_64      = "res://addons/UsdImporter/bin/release/usd_importer.windows.template_release.x86_64.dll"

linux.debug.x86_64          = "res://addons/UsdImporter/bin/usd_importer.linux.template_debug.x86_64.so"
linux.debug.dev.x86_64      = "res://addons/UsdImporter/bin/usd_importer.linux.template_debug.dev.x86_64.so"
linux.release.x86_64        = "res://addons/UsdImporter/bin/usd_importer.linux.template_release.x86_64.so"
linux.debug.arm64           = "res://addons/UsdImporter/bin/usd_importer.linux.template_debug.arm64.so"
linux.debug.dev.arm64       = "res://addons/UsdImporter/bin/usd_importer.linux.template_debug.dev.arm64.so"
linux.release.arm64         = "res://addons/UsdImporter/bin/usd_importer.linux.template_release.arm64.so"
linux.debug.rv64            = "res://addons/UsdImporter/bin/usd_importer.linux.template_debug.rv64.so"
linux.debug.dev.rv64        = "res://addons/UsdImporter/bin/usd_importer.linux.template_debug.dev.rv64.so"
linux.release.rv64          = "res://addons/UsdImporter/bin/usd_importer.linux.template_release.rv64.so"

android.debug.x86_64        = "res://addons/UsdImporter/bin/usd_importer.android.template_debug.x86_64.so"
android.debug.dev.x86_64    = "res://addons/UsdImporter/bin/usd_importer.android.template_debug.dev.x86_64.so"
android.release.x86_64      = "res://addons/UsdImporter/bin/usd_importer.android.template_release.x86_64.so"
android.debug.arm64         = "res://addons/UsdImporter/bin/usd_importer.android.template_debug.arm64.so"
android.debug.dev.arm64     = "res://addons/UsdImporter/bin/usd_importer.android.template_debug.dev.arm64.so"
android.release.arm64       = "res://addons/UsdImporter/bin/usd_importer.android.template_release.arm64.so"

[dependencies]
ios.debug = {
    "res://addons/UsdImporter/bin/libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
    "res://addons/UsdImporter/bin/libgodot-cpp.ios.template_release.xcframework": ""
}