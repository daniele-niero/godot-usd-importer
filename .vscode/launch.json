{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Attach",
            "type": "cppvsdbg",
            "request": "attach",
            "symbolSearchPath": "${workspaceFolder}/addons/debug/UsdImporter/bin"
        },
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "Godot_4.5.exe",
            "args": [
                "--editor",
                "--path",
                "${workspaceFolder}/demo_project"
            ],
            "stopAtEntry": false,
            // "cwd": "C:/path/to/GodotEditor.exe/folder",
            "environment": [],
            "symbolSearchPath": "${workspaceFolder}/addons/debug/UsdImporter/bin"

        }
    ]
}
